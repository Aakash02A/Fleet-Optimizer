# Fleet Optimizer Configuration
# Copy this file to .env and modify as needed

# Server Configuration
PORT=3000

# MongoDB Connection
# Local MongoDB
MONGODB_URI=mongodb://localhost:27017/fleet_optimizer

# Or MongoDB Atlas (cloud)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/fleet_optimizer?retryWrites=true&w=majority

# Environment
NODE_ENV=development
